# Copy this file to .env.local and fill it in before building.
#
# The OAuth2 client Mikata presents to Kamaitachi. Create one under Service
# Integrations on your Kamaitachi profile, with the Redirect URI found in
# src/config.ts and only the submit_score permission.
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_CLIENT_SECRET=
